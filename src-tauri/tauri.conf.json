{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Divit",
  "version": "0.1.0",
  "identifier": "com.firextream.divit",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Divit",
        "width": 1440,
        "height": 950,
        "minWidth": 760,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBQ0Y4ODM3OUU1NDlDRTAKUldUZ25GU2VONGpQZWs4OUJyemVZMmo5TjBSZ2VXbmdrTkhCYjlNRm5xK2xic3dSTU1OU1UwY1QK",
      "endpoints": [
        "https://github.com/Firextream/Divit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../scripts/site-bridge.mjs": "site-bridge.mjs",
      "../scripts/export-bridge.mjs": "export-bridge.mjs",
      "../scripts/backup-bridge.mjs": "backup-bridge.mjs",
      "../scripts/research-bridge.mjs": "research-bridge.mjs",
      "../scripts/research-format.mjs": "research-format.mjs"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "installMode": "currentUser",
        "startMenuFolder": "Divit"
      }
    }
  }
}
